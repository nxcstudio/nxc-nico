{
  "name": "nxc-nico",
  "version": "1.0.0",
  "description": "Node Infrastructure & Cluster Orchestrator - Autonomous Containerized DevOps Engineer",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "simulate:workflow-a": "tsx simulation/simulate-workflow-a.ts",
    "simulate:workflow-b": "tsx simulation/simulate-workflow-b.ts",
    "simulate:inbound-approval": "tsx simulation/simulate-inbound-approval.ts",
    "simulate:zero-cost": "tsx simulation/simulate-zero-cost-router.ts"
  },
  "keywords": [
    "devops",
    "kubernetes",
    "gitops",
    "autonomous-agent",
    "self-healing",
    "argocd",
    "posthog",
    "sentry"
  ],
  "author": "NXC Systems",
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/auth-app": "^6.1.1",
    "@octokit/rest": "^20.1.1",
    "@octokit/webhooks": "^13.4.0",
    "@sentry/node": "^8.26.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "nodemailer": "^6.9.14",
    "posthog-node": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
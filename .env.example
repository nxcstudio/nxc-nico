# ============================================================
# NXC-NICO (Node Infrastructure & Cluster Orchestrator) Config
# ============================================================

# General Server & Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Subsystem 1: Cognitive Core (LLM Providers)
# Options: 'gemini' | 'openai' | 'anthropic' | 'mock'
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gemini-1.5-pro

# Subsystem 2: Dockerized Sandbox Execution Engine (DinD)
# Path to docker socket or remote daemon (e.g., /var/run/docker.sock or tcp://dind:2375)
DOCKER_HOST=
DOCKER_TLS_VERIFY=0
SANDBOX_TIMEOUT_MS=120000
SANDBOX_CONTAINER_IMAGE=node:20-alpine

# Subsystem 3: Git Integration Daemon (GitHub App)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/etc/nico/github-app.private-key.pem
GITHUB_APP_INSTALLATION_ID=7891011
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Subsystem 4: Telemetry & Cross-Repository Bus
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_WEBHOOK_SECRET=your_sentry_webhook_secret_here
POSTHOG_API_KEY=phc_your_posthog_project_api_key_here
POSTHOG_HOST=https://app.posthog.com

# Subsystem 5: Mail Dispatcher & Inbound Gateway
# Provider: 'resend' | 'sendgrid' | 'smtp' | 'console'
MAIL_PROVIDER=console
MAIL_FROM=nico@nxc.internal
MAIL_TO_DEFAULT=devops-alerts@nxc.internal
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@nxc.internal
SMTP_PASS=your_smtp_password
INBOUND_MAIL_WEBHOOK_SECRET=your_inbound_secret_here

# Kubernetes & ArgoCD (GitOps)
KUBERNETES_IN_CLUSTER=false
ARGOCD_SERVER=argocd.internal.nxc.systems
ARGOCD_AUTH_TOKEN=your_argocd_auth_token_here
